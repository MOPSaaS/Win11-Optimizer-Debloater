# Build artifacts (Build-Release.ps1 compiles Win11Optimizer.exe into the project root)
out/
*.exe
*.msi
*.msix

# Build intermediate files generated by Build-Release.ps1 (safe to regenerate)
Assets/payload.zip
Assets/Launcher.cs
Assets/icon.ico

# PowerShell Module artifacts
*.psd1.bak

# Logs and runtime data (these belong in ProgramData, not the repo)
logs/
*.log

# IDE / editor
.vs/
.vscode/
*.user
*.suo

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# PowerShell ISE / PSScriptAnalyzer cache
.psanalyzer/

# Local env / secrets
*.local.ps1
.env
